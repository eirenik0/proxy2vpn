{
  "uid": "proxy2vpn-fleet",
  "title": "Proxy2VPN fleet evidence",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Operator runbooks",
      "url": "https://github.com/eirenik0/proxy2vpn/blob/main/monitoring/RUNBOOK.md",
      "type": "link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "proxy2vpn-prometheus"
        },
        "query": "label_values(proxy2vpn_cycle_attempts_total, deployment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      },
      {
        "name": "source",
        "type": "custom",
        "query": "gluetun,external_proxy",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter reachability",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "proxy2vpn-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"proxy2vpn\"}",
          "legendFormat": "{{deployment}} {{endpoint}} {{source}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No monitoring data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
